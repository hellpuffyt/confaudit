# Intentionally insecure sshd_config used as a fixture for confaudit's
# tests and CI smoke checks. Do not deploy this file.
Port 22
PermitRootLogin yes
PasswordAuthentication yes
PermitEmptyPasswords yes
Protocol 2,1
Ciphers aes256-gcm@openssh.com,3des-cbc,arcfour
MACs hmac-sha2-256,hmac-md5
KexAlgorithms curve25519-sha256,diffie-hellman-group1-sha1
X11Forwarding yes
AllowTcpForwarding yes
MaxAuthTries 20
PermitUserEnvironment yes
UsePAM no

Match User deploy
    PasswordAuthentication no
    PermitRootLogin no
